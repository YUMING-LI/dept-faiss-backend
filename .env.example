# OpenAI API Key（必填）
OPENAI_API_KEY=sk-...

# Project 設定：格式 project_id:index_map_file，多個用逗號分隔
# index_map_file 路徑相對於 app.py 所在目錄
PROJECTS=default:index_map.json

# FAISS 搜尋參數
EMBEDDING_MODEL=text-embedding-3-small
TOP_K=5
ROUTE_TOP_N=3
VECTOR_CACHE_MAX=50

# API 認證（留空則停用）
API_TOKEN=

# CORS（多個用逗號分隔）
ALLOWED_ORIGINS=

# PostgreSQL 持久化（PG_STORE_ENABLED=0 可關閉）
PG_STORE_ENABLED=1
DB_HOST=10.1.207.19
DB_PORT=5432
DB_NAME=edah_sh
DB_USER=postgres
DB_PASSWORD=
DB_SSLMODE=disable

# 調試模式
DEBUG=0
PORT=80
